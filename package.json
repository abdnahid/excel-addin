{
  "name": "bangla-converter-excel-addin",
  "version": "1.0.0",
  "private": true,
  "description": "Excel add-in for Bengali Bijoy (ANSI) <-> Unicode conversion by ABDNAHID",
  "author": "ABDNAHID <abdalgolabs@gmail.com>",
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/office-js": "^1.0.609",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-manifest": "^3.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
